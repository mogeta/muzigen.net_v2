---
import Layout from "./Layout.astro";

interface Frontmatter {
	title?: string;
	description?: string;
	updatedAt?: string;
}

interface Props {
	frontmatter?: Frontmatter;
	title?: string;
	description?: string;
	updatedAt?: string;
}

const frontmatter = Astro.props.frontmatter ?? {};
const title = Astro.props.title ?? frontmatter.title ?? "Kiritori";
const description =
	Astro.props.description ??
	frontmatter.description ??
	"Kiritoriに関するドキュメントです。";
const updatedAt =
	Astro.props.updatedAt ?? frontmatter.updatedAt ?? "2026年6月30日";

const pages = [
	{ href: "/app/kiritori/term", label: "利用規約" },
	{ href: "/app/kiritori/privacy", label: "プライバシーポリシー" },
	{ href: "/app/kiritori/tokushoho", label: "特定商取引法" },
	{ href: "/app/kiritori/support", label: "サポート" },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "");
---

<Layout title={`${title} - Kiritori`} description={description}>
	<main id="main-content" class="mx-auto w-full max-w-4xl px-4 py-10 md:py-14">
		<header class="mb-8">
			<a
				href="/"
				class="mb-5 inline-flex text-sm font-medium text-gray-600 transition-colors hover:text-gray-900"
			>
				muzigen.net
			</a>
			<p class="mb-2 text-sm font-semibold uppercase tracking-wider text-gray-500">
				Kiritori
			</p>
			<h1 class="text-3xl font-bold text-gray-950 md:text-4xl">{title}</h1>
			<p class="mt-4 max-w-2xl text-base leading-7 text-gray-700">
				{description}
			</p>
			<p class="mt-3 text-sm text-gray-500">最終更新日: {updatedAt}</p>

			<nav
				aria-label="Kiritori documents"
				class="mt-6 flex flex-wrap gap-2 border-y border-gray-200 py-3"
			>
				{
					pages.map((page) => {
						const isCurrent = page.href === currentPath;

						return (
							<a
								href={page.href}
								aria-current={isCurrent ? "page" : undefined}
								class:list={[
									"rounded-md px-3 py-2 text-sm font-medium transition-colors",
									isCurrent
										? "bg-gray-900 text-white"
										: "text-gray-700 hover:bg-gray-100 hover:text-gray-950",
								]}
							>
								{page.label}
							</a>
						);
					})
				}
			</nav>
		</header>

		<article
			class="kiritori-document rounded-lg border border-gray-200 bg-white p-6 text-gray-800 shadow-sm md:p-10"
		>
			<slot />
		</article>
	</main>
</Layout>

<style>
	:global(.kiritori-document h2) {
		margin-top: 2rem;
		margin-bottom: 0.75rem;
		border-bottom: 1px solid #e5e7eb;
		padding-bottom: 0.5rem;
		color: #111827;
		font-size: 1.25rem;
		font-weight: 700;
	}

	:global(.kiritori-document h2:first-child) {
		margin-top: 0;
	}

	:global(.kiritori-document h3) {
		margin-top: 1.5rem;
		margin-bottom: 0.5rem;
		color: #111827;
		font-size: 1rem;
		font-weight: 700;
	}

	:global(.kiritori-document p),
	:global(.kiritori-document li),
	:global(.kiritori-document dd),
	:global(.kiritori-document blockquote) {
		line-height: 1.75;
	}

	:global(.kiritori-document p),
	:global(.kiritori-document ul),
	:global(.kiritori-document ol),
	:global(.kiritori-document dl),
	:global(.kiritori-document blockquote),
	:global(.kiritori-document table) {
		margin-top: 1rem;
	}

	:global(.kiritori-document ul),
	:global(.kiritori-document ol) {
		padding-left: 1.25rem;
	}

	:global(.kiritori-document ul) {
		list-style: disc;
	}

	:global(.kiritori-document ol) {
		list-style: decimal;
	}

	:global(.kiritori-document a) {
		color: #2563eb;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	:global(.kiritori-document blockquote) {
		border-left: 4px solid #9ca3af;
		background: #f9fafb;
		padding: 1rem;
		color: #374151;
	}

	:global(.kiritori-document blockquote p) {
		margin-top: 0;
	}

	:global(.kiritori-document table) {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.95rem;
	}

	:global(.kiritori-document th),
	:global(.kiritori-document td) {
		border: 1px solid #e5e7eb;
		padding: 0.75rem;
		text-align: left;
		vertical-align: top;
	}

	:global(.kiritori-document th) {
		width: 34%;
		background: #f9fafb;
		color: #111827;
		font-weight: 700;
	}

	@media (max-width: 640px) {
		:global(.kiritori-document table),
		:global(.kiritori-document tbody),
		:global(.kiritori-document tr),
		:global(.kiritori-document th),
		:global(.kiritori-document td) {
			display: block;
			width: 100%;
		}

		:global(.kiritori-document tr + tr) {
			margin-top: 0.75rem;
		}
	}
</style>
