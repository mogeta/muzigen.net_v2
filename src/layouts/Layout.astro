---
import "../styles/global.css";
// Self-hosted Inter font (eliminates external font requests)
import "@fontsource/inter/300.css";
import "@fontsource/inter/400.css";
import "@fontsource/inter/500.css";
import "@fontsource/inter/600.css";
import "@fontsource/inter/700.css";
import "@fontsource/inter/900.css";
import Footer from "../components/Footer.astro";
import GoogleAnalytics from "../components/GoogleAnalytics.astro";

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	ogType?: "website" | "article" | "profile";
	publishedTime?: string;
	modifiedTime?: string;
	canonicalURL?: string;
}

const {
	title = "muzigen.net",
	description = "muzigen.netのウェブサイト",
	ogImage,
	ogType = "website",
	publishedTime,
	modifiedTime,
	canonicalURL,
} = Astro.props;

// AdSense configuration
const isProd = import.meta.env.PROD;
const adClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;

// Use provided canonical URL or default to current page URL without query parameters
const canonical = canonicalURL || `${Astro.url.origin}${Astro.url.pathname}`;

// OGP image - use provided image or default
const siteUrl = Astro.site?.origin || "https://muzigen.net";
const resolvedOgImage = ogImage
	? ogImage.startsWith("http")
		? ogImage
		: `${siteUrl}${ogImage.startsWith("/") ? "" : "/"}${ogImage}`
	: `${siteUrl}/ogp_default.png`;

const pageTitle = title === "muzigen.net" ? title : `${title} | muzigen.net`;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="canonical" href={canonical} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link
			rel="alternate"
			type="application/rss+xml"
			title="muzigen.net - Blog RSS Feed"
			href="/rss.xml"
		/>
		<link
			rel="alternate"
			type="application/rss+xml"
			title="muzigen.net - Posts RSS Feed"
			href="/posts/rss.xml"
		/>
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#0a0a0a" />

		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonical} />
		<meta property="og:locale" content="ja_JP" />
		<meta property="og:site_name" content="muzigen.net" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={resolvedOgImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		{
			ogType === "article" && (
				<>
					{publishedTime && (
						<meta
							propertfy="article:published_time"
							content={publishedTime}
						/>
					)}
					{modifiedTime && (
						<meta
							property="article:modified_time"
							content={modifiedTime}
						/>
					)}
				</>
			)
		}

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content="@mogetta" />
		<meta name="twitter:creator" content="@mogetta" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={resolvedOgImage} />

		<GoogleAnalytics />

		<!-- Google AdSense (Auto Ads) -->
		{
			isProd && adClient && (
				<script
					async
					src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adClient}`}
					crossorigin="anonymous"
				></script>
			)
		}

		<!-- Inline critical styles for background to prevent white flash -->
		<style is:inline>
			.ambient-light {
				position: fixed;
				top: 0;
				left: 0;
				width: 100vw;
				height: 100vh;
				z-index: -2;
				background:
					radial-gradient(
						circle at 15% 50%,
						rgba(0, 243, 255, 0.1),
						transparent 25%
					),
					radial-gradient(
						circle at 85% 30%,
						rgba(255, 0, 255, 0.1),
						transparent 25%
					);
				filter: blur(60px);
				pointer-events: none;
				/* Smoother animation */
				will-change: transform, opacity;
				animation: ambient-pulse 10s ease-in-out infinite alternate;
			}

			.noise-overlay {
				position: fixed;
				top: 0;
				left: 0;
				width: 100vw;
				height: 100vh;
				z-index: -1;
				background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='1'/%3E%3C/svg%3E");
				opacity: 0.05;
				pointer-events: none;
			}

			@keyframes ambient-pulse {
				0% {
					transform: scale(1);
					opacity: 0.8;
				}
				100% {
					transform: scale(1.1);
					opacity: 1;
				}
			}
		</style>
	</head>
	<body
		class="antialiased min-h-screen text-white selection:bg-fuchsia-500 selection:text-white overflow-x-hidden"
	>
		<div class="ambient-light"></div>
		<div class="noise-overlay"></div>

		<main class="relative z-10 flex flex-col min-h-screen">
			<slot />
		</main>

		<Footer />

		<script>
			// System Online Log
			// console.log('%c SYSTEM ONLINE %c muzigen.net v2.0 ', 'background: #00f3ff; color: #000; font-weight: bold; padding: 4px;', 'background: #000; color: #00f3ff; padding: 4px;');

			// Effect: Shatter on Click (Global)
			// Apply to any element with .cyber-button or .cyber-card class
			document.addEventListener("click", (e) => {
				const target = (e.target as Element).closest(
					".cyber-button, .cyber-card",
				);
				if (target) {
					target.classList.add("shattered");
					setTimeout(() => {
						target.classList.remove("shattered");
					}, 500);
				}
			});
		</script>
	</body>
</html>
