---
import Layout from "./Layout.astro";

type DocumentKey = "terms" | "privacy" | "commercial-transactions" | "support";
type DocumentLang = "ja" | "en";

interface Frontmatter {
	title?: string;
	description?: string;
	updatedAt?: string;
	appName?: string;
	appBasePath?: string;
	lang?: DocumentLang;
	documentKey?: DocumentKey;
}

interface Props {
	frontmatter?: Frontmatter;
	title?: string;
	description?: string;
	updatedAt?: string;
	appName?: string;
	appBasePath?: string;
	lang?: DocumentLang;
	documentKey?: DocumentKey;
}

const frontmatter = Astro.props.frontmatter ?? {};
const appName = Astro.props.appName ?? frontmatter.appName ?? "Fuchi";
const appBasePath = Astro.props.appBasePath ?? frontmatter.appBasePath ?? "/app/Fuchi";
const lang = Astro.props.lang ?? frontmatter.lang ?? "ja";
const documentKey =
	Astro.props.documentKey ??
	frontmatter.documentKey ??
	(Astro.url.pathname.split("/").filter(Boolean).at(-1) as DocumentKey | undefined) ??
	"support";
const title = Astro.props.title ?? frontmatter.title ?? appName;
const description =
	Astro.props.description ??
	frontmatter.description ??
	(lang === "en"
		? `${appName} documentation.`
		: `${appName}に関するドキュメントです。`);
const updatedAt =
	Astro.props.updatedAt ??
	frontmatter.updatedAt ??
	(lang === "en" ? "July 7, 2026" : "2026年7月7日");

const labels = {
	ja: {
		siteBack: "muzigen.net",
		updatedAt: "最終更新日",
		languageLabel: "Language",
		navLabel: `${appName} documents`,
		languageNames: {
			ja: "日本語",
			en: "English",
		},
		pages: {
			terms: "利用規約",
			privacy: "プライバシーポリシー",
			"commercial-transactions": "特定商取引法",
			support: "サポート",
		},
	},
	en: {
		siteBack: "muzigen.net",
		updatedAt: "Last updated",
		languageLabel: "Language",
		navLabel: `${appName} documents`,
		languageNames: {
			ja: "日本語",
			en: "English",
		},
		pages: {
			terms: "Terms",
			privacy: "Privacy Policy",
			"commercial-transactions": "Commercial Transactions",
			support: "Support",
		},
	},
} as const;

const pages: DocumentKey[] = [
	"terms",
	"privacy",
	"commercial-transactions",
	"support",
];
const languages: DocumentLang[] = ["ja", "en"];
const currentPath = Astro.url.pathname.replace(/\/$/, "");
const siteUrl = Astro.site?.origin ?? Astro.url.origin;
const canonicalPath = `${appBasePath}/${lang}/${documentKey}`;
const canonicalURL = `${siteUrl}${canonicalPath}`;
const alternateLinks: { hrefLang: string; href: string }[] = languages.map((language) => ({
	hrefLang: language,
	href: `${siteUrl}${appBasePath}/${language}/${documentKey}`,
}));
alternateLinks.push({
	hrefLang: "x-default",
	href: `${siteUrl}${appBasePath}/ja/${documentKey}`,
});
const text = labels[lang];
---

<Layout
	title={`${title} - ${appName}`}
	description={description}
	canonicalURL={canonicalURL}
	lang={lang}
	alternateLinks={alternateLinks}
>
	<main id="main-content" class="mx-auto w-full max-w-4xl px-4 py-10 md:py-14">
		<header class="mb-8">
			<a
				href="/"
				class="mb-5 inline-flex text-sm font-medium text-gray-300 transition-colors hover:text-white"
			>
				{text.siteBack}
			</a>
			<div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
				<div>
					<p class="mb-2 text-sm font-semibold uppercase text-gray-400">
						{appName}
					</p>
					<h1 class="text-3xl font-bold text-white md:text-4xl">{title}</h1>
					<p class="mt-4 max-w-2xl text-base leading-7 text-gray-300">
						{description}
					</p>
					<p class="mt-3 text-sm text-gray-400">
						{text.updatedAt}: {updatedAt}
					</p>
				</div>

				<nav
					aria-label={text.languageLabel}
					class="flex shrink-0 gap-2 rounded-md border border-white/10 bg-black/20 p-1"
				>
					{
						languages.map((language) => {
							const isCurrent = language === lang;

							return (
								<a
									href={`${appBasePath}/${language}/${documentKey}`}
									aria-current={isCurrent ? "page" : undefined}
									class:list={[
										"rounded px-3 py-1.5 text-sm font-medium transition-colors",
										isCurrent
											? "bg-white text-gray-950"
											: "text-gray-300 hover:bg-white/10 hover:text-white",
									]}
								>
									{text.languageNames[language]}
								</a>
							);
						})
					}
				</nav>
			</div>

			<nav
				aria-label={text.navLabel}
				class="mt-6 flex flex-wrap gap-2 border-y border-white/10 py-3"
			>
				{
					pages.map((page) => {
						const href = `${appBasePath}/${lang}/${page}`;
						const isCurrent = href === currentPath;

						return (
							<a
								href={href}
								aria-current={isCurrent ? "page" : undefined}
								class:list={[
									"rounded-md px-3 py-2 text-sm font-medium transition-colors",
									isCurrent
										? "bg-white text-gray-950"
										: "text-gray-300 hover:bg-white/10 hover:text-white",
								]}
							>
								{text.pages[page]}
							</a>
						);
					})
				}
			</nav>
		</header>

		<article
			class="app-document rounded-lg border border-white/10 bg-white p-6 text-gray-800 shadow-sm md:p-10"
		>
			<slot />
		</article>
	</main>
</Layout>

<style>
	:global(.app-document h2) {
		margin-top: 2rem;
		margin-bottom: 0.75rem;
		border-bottom: 1px solid #e5e7eb;
		padding-bottom: 0.5rem;
		color: #111827;
		font-size: 1.25rem;
		font-weight: 700;
	}

	:global(.app-document h2:first-child) {
		margin-top: 0;
	}

	:global(.app-document h3) {
		margin-top: 1.5rem;
		margin-bottom: 0.5rem;
		color: #111827;
		font-size: 1rem;
		font-weight: 700;
	}

	:global(.app-document p),
	:global(.app-document li),
	:global(.app-document dd),
	:global(.app-document blockquote) {
		line-height: 1.75;
	}

	:global(.app-document p),
	:global(.app-document ul),
	:global(.app-document ol),
	:global(.app-document dl),
	:global(.app-document blockquote),
	:global(.app-document table) {
		margin-top: 1rem;
	}

	:global(.app-document ul),
	:global(.app-document ol) {
		padding-left: 1.25rem;
	}

	:global(.app-document ul) {
		list-style: disc;
	}

	:global(.app-document ol) {
		list-style: decimal;
	}

	:global(.app-document a) {
		color: #2563eb;
		text-decoration: underline;
		text-underline-offset: 2px;
	}

	:global(.app-document blockquote) {
		border-left: 4px solid #9ca3af;
		background: #f9fafb;
		padding: 1rem;
		color: #374151;
	}

	:global(.app-document blockquote p) {
		margin-top: 0;
	}

	:global(.app-document table) {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.95rem;
	}

	:global(.app-document th),
	:global(.app-document td) {
		border: 1px solid #e5e7eb;
		padding: 0.75rem;
		text-align: left;
		vertical-align: top;
	}

	:global(.app-document th) {
		width: 34%;
		background: #f9fafb;
		color: #111827;
		font-weight: 700;
	}

	@media (max-width: 640px) {
		:global(.app-document table),
		:global(.app-document tbody),
		:global(.app-document tr),
		:global(.app-document th),
		:global(.app-document td) {
			display: block;
			width: 100%;
		}

		:global(.app-document tr + tr) {
			margin-top: 0.75rem;
		}
	}
</style>
