---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Chirashi - Ebiten Game">
	<div class="game-container">
		<div class="iframe-wrapper">
			<iframe
				src="/chirashi/main.html"
				width="640"
				height="700"
				allow="autoplay"
				title="Ebiten Game - Chirashi"
			></iframe>
		</div>
	</div>
</Layout>

<style>
	.game-container {
		display: flex;
		justify-content: center;
		align-items: center;
		min-height: 100vh;
		padding: 2rem;
		background-color: #f0f0f0;
	}

	.iframe-wrapper {
		width: 1280px;
		height: 960px;
		overflow: hidden;
		background: white;
		box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
		border-radius: 8px;
	}

	iframe {
		border: none;
		transform: scale(0.5);
		transform-origin: 0 0;
		width: 200%;
		height: 200%;
	}

	@media (max-width: 1360px) {
		.iframe-wrapper {
			width: 90vw;
			height: calc(90vw * 0.75);
		}
	}

	@media (max-width: 768px) {
		.game-container {
			padding: 1rem;
		}

		.iframe-wrapper {
			width: 100%;
			height: calc(100vw * 0.75);
		}
	}
</style>
