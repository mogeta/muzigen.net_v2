---
import Layout from '../layouts/Layout.astro';
import HomeVerseNFTList from '../components/HomeVerseNFTList.jsx';

// URLパラメータからアドレスを取得、デフォルトは例のアドレス
const url = new URL(Astro.request.url);
const address = url.searchParams.get('address') || '';
const type = url.searchParams.get('type') || ''; // ERC-721 or ERC-1155
---

<Layout title="HomeVerse NFT Collections">
    <div style="max-width: 1200px; margin: 0 auto; padding: 20px;">
        <h1>HomeVerse NFT Collections</h1>

        <div style="background: #f5f5f5; padding: 20px; border-radius: 8px; margin-bottom: 20px;">
            <h2 style="margin-top: 0;">アドレスを指定</h2>
            <form method="get" style="display: flex; gap: 10px; align-items: flex-end;">
                <div style="flex: 1;">
                    <label for="address" style="display: block; margin-bottom: 5px; font-weight: bold;">
                        ウォレットアドレス:
                    </label>
                    <input
                        type="text"
                        id="address"
                        name="address"
                        value={address}
                        placeholder="0x..."
                        style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px; font-family: monospace;"
                    />
                </div>
                <div style="min-width: 200px;">
                    <label for="type" style="display: block; margin-bottom: 5px; font-weight: bold;">
                        NFTタイプ (オプション):
                    </label>
                    <select
                        id="type"
                        name="type"
                        style="width: 100%; padding: 10px; border: 1px solid #ddd; border-radius: 4px;"
                    >
                        <option value="">すべて</option>
                        <option value="ERC-721" selected={type === 'ERC-721'}>ERC-721</option>
                        <option value="ERC-1155" selected={type === 'ERC-1155'}>ERC-1155</option>
                    </select>
                </div>
                <button
                    type="submit"
                    style="padding: 10px 30px; background: #0070f3; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold;"
                >
                    検索
                </button>
            </form>

            <p style="margin-top: 10px; font-size: 14px; color: #666;">
                ℹ️ URLパラメータで指定できます: <code>?address=0x...&type=ERC-721</code>
            </p>
        </div>

        <HomeVerseNFTList address={address} type={type} client:only="react" />
    </div>
</Layout>
