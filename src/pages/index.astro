---
import Layout from "../layouts/Layout.astro";
import GlitchText from "../components/GlitchText.astro";
import OrganizationSchema from "../components/OrganizationSchema.astro";
---

<Layout>
	<OrganizationSchema />

	<!-- Hero Section -->
	<section
		class="relative min-h-screen flex items-center justify-center overflow-hidden"
	>
		<!-- Content -->
		<div
			class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center"
		>
			<div class="fade-in-up space-y-8">
				<h1 class="font-black mb-6 tracking-tighter">
					<GlitchText
						text="muzigen.net"
						as="span"
						class="text-6xl sm:text-8xl lg:text-9xl text-transparent bg-clip-text bg-gradient-to-r from-cyan-600 via-gray-800 to-fuchsia-600 always-active"
					/>
				</h1>

				<p
					class="text-xl sm:text-3xl text-gray-800 max-w-3xl mx-auto font-light tracking-wide"
				>
					<span class="text-neon-cyan drop-shadow-sm font-medium"
						>Game Developer</span
					> & <span
						class="text-neon-magenta drop-shadow-sm font-medium"
						>Freelance IT Engineer</span
					>
				</p>

				<p
					class="text-base sm:text-lg text-gray-600 mb-12 max-w-xl mx-auto border-l-2 border-neon-cyan pl-4 text-left"
				>
					Exploring the chaotic boundary between game dev and modern
					web tech.
					<br class="hidden sm:block" />
					Building digital experiences with raw energy.
				</p>

				<div
					class="flex flex-col sm:flex-row gap-6 justify-center items-center mt-12"
				>
					<a href="/blog" class="cyber-button group">
						<span
							class="relative z-10 group-hover:text-white transition-colors duration-100"
							>View Transmissions</span
						>
						<div
							class="glitch-bg absolute inset-0 bg-neon-cyan transform scale-x-0 group-hover:scale-x-100 transition-transform duration-200 origin-left"
						>
						</div>
					</a>
					<a href="#about" class="cyber-button-outline">
						<span class="relative z-10">Initialize System</span>
					</a>
				</div>
			</div>
		</div>

		<!-- Decorative Elements -->
		<div
			class="absolute bottom-10 left-10 text-xs text-gray-400 font-mono hidden sm:block z-50"
		>
			<a
				id="dynamic-coords"
				href="https://www.google.com/maps?q=35.6895,139.6917"
				target="_blank"
				class="hover:text-neon-cyan transition-colors cursor-pointer block mb-1"
			>
				COORD: 35.6895° N, 139.6917° E
			</a>
			STATUS: ONLINE
		</div>
	</section>

	<!-- About Section -->
	<section id="about" class="py-32 relative">
		<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
				<div class="fade-in-left relative group">
					<div
						class="absolute -inset-1 bg-gradient-to-r from-neon-cyan to-neon-magenta opacity-30 group-hover:opacity-100 blur transition duration-1000 group-hover:duration-200"
					>
					</div>
					<img
						src="/top.jpg"
						alt="Profile"
						class="relative rounded-lg shadow-2xl w-full h-auto object-cover grayscale contrast-125 hover:grayscale-0 transition-all duration-500 glass-panel"
					/>
				</div>
				<div class="fade-in-right space-y-8">
					<h2 class="text-4xl font-bold mb-6 text-gray-900">
						<span class="text-neon-cyan">#</span> About_Me
					</h2>
					<p class="text-lg text-gray-700 leading-relaxed font-light">
						I am a digital architect operating at the intersection
						of gameplay logic and frontend aesthetics. My mission is
						to craft immersive interfaces that feel alive.
					</p>

					<div
						class="glass-panel p-6 rounded-none border-l-4 border-neon-magenta"
					>
						<h3 class="text-xl font-bold mb-4 text-neon-magenta">
							Active Protocols
						</h3>
						<div class="flex flex-wrap gap-3">
							{
								[
									"Game Development",
									"Web Engineering",
									"Astro",
									"TypeScript",
									"Firebase",
									"GLSL",
								].map((skill) => (
									<span class="px-3 py-1 bg-black/5 border border-black/10 text-gray-800 text-sm tracking-wider hover:bg-neon-cyan/20 hover:border-neon-cyan transition-colors cursor-crosshair">
										{skill}
									</span>
								))
							}
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Features Section -->
	<section class="py-32 relative">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-24 fade-in-up">
				<h2 class="text-4xl sm:text-5xl font-black mb-4 text-gray-900">
					<GlitchText text="SYSTEM MODULES" />
				</h2>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
				{
					[
						{
							icon: "👤",
							title: "Profile",
							desc: "Game Developer & Web Engineer. Access personal data and skillset.",
							link: "/profile",
						},
						{
							icon: "📝",
							title: "Blog",
							desc: "Technical transmissions, tutorials, and development logs.",
							link: "/blog",
						},
						{
							icon: "📰",
							title: "Chirashi",
							desc: "Special content and digital leaflets from the void.",
							link: "/chirashi/main.html",
						},
					].map((feature, i) => (
						<a
							href={feature.link}
							class="cyber-card group block text-left"
							style={`animation-delay: ${i * 0.1}s;`}
						>
							<div class="text-6xl mb-6 group-hover:scale-110 transition-transform duration-300 grayscale group-hover:grayscale-0">
								{feature.icon}
							</div>
							<h3 class="text-2xl font-bold mb-4 text-gray-900 group-hover:text-neon-cyan transition-colors">
								{feature.title}
							</h3>
							<p class="text-gray-600 group-hover:text-gray-900 transition-colors">
								{feature.desc}
							</p>
							<div class="absolute -bottom-1 -right-1 w-4 h-4 border-b-2 border-r-2 border-neon-cyan opacity-0 group-hover:opacity-100 transition-opacity" />
						</a>
					))
				}
			</div>
		</div>
	</section>

	<!-- CTA Section -->
	<section class="py-32 relative overflow-hidden">
		<!-- Dynamic Grid Background -->
		<div
			class="absolute inset-0 z-0 bg-grid-pattern opacity-10 transform perspective-1000 rotate-x-60 pointer-events-none"
		>
		</div>

		<div class="max-w-4xl mx-auto px-4 text-center relative z-10">
			<div
				class="glass-panel p-12 border border-black/10 relative overflow-hidden group"
			>
				<div
					class="absolute inset-0 bg-gradient-to-r from-neon-cyan/5 to-neon-magenta/5 opacity-0 group-hover:opacity-100 transition-opacity duration-500"
				>
				</div>

				<h2 class="text-4xl sm:text-6xl font-bold mb-8 text-gray-900">
					Ready to <span class="text-neon-cyan">Dive In?</span>
				</h2>
				<p class="text-xl text-gray-600 mb-10 max-w-2xl mx-auto">
					Access the knowledge base. Read the latest execution logs.
				</p>
				<a href="/blog" class="cyber-button inline-block min-w-[200px]">
					<span class="relative z-10 group-hover:text-white"
						>ACCESS BLOG</span
					>
					<div
						class="glitch-bg absolute inset-0 bg-gray-900 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-200 origin-left"
					>
					</div>
				</a>
			</div>
		</div>
	</section>
</Layout>

<script>
	function updateCoordinates() {
		const coordsEl = document.getElementById(
			"dynamic-coords",
		) as HTMLAnchorElement;
		if (!coordsEl) return;

		// Random coordinates generator
		// Lat: -90 to 90
		// Lng: -180 to 180
		const lat = Math.random() * 180 - 90;
		const lng = Math.random() * 360 - 180;

		const latDir = lat >= 0 ? "N" : "S";
		const lngDir = lng >= 0 ? "E" : "W";

		const formattedLat = Math.abs(lat).toFixed(4);
		const formattedLng = Math.abs(lng).toFixed(4);

		coordsEl.textContent = `COORD: ${formattedLat}° ${latDir}, ${formattedLng}° ${lngDir}`;
		coordsEl.href = `https://www.google.com/maps?q=${lat},${lng}`;
	}

	// Update on load
	document.addEventListener("DOMContentLoaded", updateCoordinates);
</script>
