---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import type {BlogListItem} from '../../types/blog';
import {getFirestore} from 'firebase-admin/firestore';
import {app} from '../../firebase/server';
import BreadcrumbSchema from '../../components/BreadcrumbSchema.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

export async function getStaticPaths() {
	const db = getFirestore(app);

	try {
		const snapshot = await db.collection('blog_contents')
			.where('publish', '==', true)
			.get();

		// Group articles by tag in a single pass
		const articlesByTag = new Map<string, BlogListItem[]>();
		snapshot.docs.forEach(doc => {
			const data = doc.data();
			// Support both tags array and legacy tag string
			const tags = data.tags || (data.tag ? [data.tag] : []);
			if (Array.isArray(tags)) {
				tags.forEach(tag => {
					if (tag && typeof tag === 'string') {
						const articlesForTag = articlesByTag.get(tag) || [];
						const article: BlogListItem = {
							id: doc.id,
							slug: data.slug || undefined,
							title: data.title || '',
							description: data.description || '',
							ogp_image: data.ogp_image || '',
							tags: data.tags,
							tag: data.tag,
							update_date: data.update_date?.toDate?.()?.toISOString() || data.update_date || '',
							created_date: data.created_date?.toDate?.()?.toISOString() || data.created_date || '',
						};
						articlesForTag.push(article);
						articlesByTag.set(tag, articlesForTag);
					}
				});
			}
		});

		// Generate paths for each tag
		return Array.from(articlesByTag.entries()).map(([tag, articles]) => {
			// Sort articles within each tag group
			articles.sort((a, b) => {
				const dateA = new Date(a.created_date).getTime();
				const dateB = new Date(b.created_date).getTime();
				return dateB - dateA;
			});

			return {
				params: {tag},
				props: {tag, articles}
			};
		});
	} catch (error) {
		console.error('Error fetching tags:', error);
		return [];
	}
}

const {tag, articles} = Astro.props;
---

<Layout
	title={`${tag} の記事一覧`}
	description={`${tag} に関する記事一覧ページ。${articles.length}件の記事があります。`}
>
	<BreadcrumbSchema
		items={[
			{ name: 'ホーム', url: '/' },
			{ name: 'ブログ', url: '/blog' },
			{ name: 'タグ一覧', url: '/tags' },
			{ name: tag, url: `/tags/${encodeURIComponent(tag)}` }
		]}
	/>
	<a href="#main-content" class="skip-to-main">メインコンテンツへスキップ</a>

	<main id="main-content" class="max-w-6xl mx-auto px-4 py-12">
		<!-- パンくずナビゲーション -->
		<Breadcrumb
			items={[
				{ name: 'ホーム', url: '/' },
				{ name: 'ブログ', url: '/blog' },
				{ name: 'タグ一覧', url: '/tags' },
				{ name: tag, url: `/tags/${encodeURIComponent(tag)}` }
			]}
		/>

		<!-- Header -->
		<header class="mb-12">

			<div class="flex items-center gap-4 mb-4">
				<div class="px-6 py-3 bg-blue-600 text-white font-bold rounded-full text-lg">
					#{tag}
				</div>
				<span class="text-gray-600">
					{articles.length}件
				</span>
			</div>

			<h1 class="text-5xl font-bold text-gray-900 mb-4">
				{tag} の記事
			</h1>
		</header>

		{articles.length > 0 ? (
			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
				{articles.map((article) => (
					<ArticleCard article={article} />
				))}
			</div>
		) : (
			<div class="text-center py-20">
				<div class="w-20 h-20 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-6">
					<svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
					</svg>
				</div>
				<h2 class="text-2xl font-bold text-gray-900 mb-2">記事がありません</h2>
				<p class="text-gray-600 mb-8">このタグの記事はまだありません</p>
				<a
					href="/blog"
					class="inline-flex items-center gap-2 px-6 py-3 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors"
				>
					すべての記事を見る
					<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
					</svg>
				</a>
			</div>
		)}
	</main>
</Layout>
