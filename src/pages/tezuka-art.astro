---
import Layout from "../layouts/Layout.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";
import { LinkPreview } from "astro-embed";

const page = {
  title: "Tezuka Art NFT+",
  description: "Tezuka Art NFT+ 公式ページのプレビューとリンク。",
  url: "https://tezuka-art.nftplus.io/ja",
};
---

<Layout title={page.title} description={page.description} ogType="website">
  <BreadcrumbSchema
    items={[
      { name: "ホーム", url: "/" },
      { name: page.title, url: "/tezuka-art" },
    ]}
  />

  <main id="main-content" class="max-w-4xl mx-auto px-4 py-12">
    <section class="bg-white rounded-2xl shadow-lg border border-gray-200 p-8">
      <h1 class="text-3xl font-bold text-gray-900 mb-4">{page.title}</h1>
      <p class="text-gray-700 mb-6">
        {page.description}
      </p>

      <div class="mb-6">
        <LinkPreview id={page.url} />
      </div>

      <a
        href={page.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium"
      >
        公式ページを開く
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"
          ></path>
        </svg>
      </a>
    </section>
  </main>
</Layout>

<style>
  .link-preview {
    --link-preview-width: 100%;
    --link-preview-corners: 16px;
    --link-preview-padding-inline: 1rem;
    --link-preview-padding-block: 0.75rem;
  }

  .link-preview a {
    color: #0f172a;
  }
</style>
