---
import Layout from "../../layouts/Layout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import EmptyState from "../../components/EmptyState.astro";
import BlogSchema from "../../components/BlogSchema.astro";
import Pagination from "../../components/Pagination.astro";
import type { BlogListItem } from "../../types/blog";
import type { Page, GetStaticPaths } from "astro";
import { getFirestore } from "firebase-admin/firestore";
import { app } from "../../firebase/server";

export const getStaticPaths = (async ({ paginate }) => {
  let articles: BlogListItem[];

  try {
    const db = getFirestore(app);

    const snapshot = await db
      .collection("blog_contents")
      .where("publish", "==", true)
      .orderBy("created_date", "desc")
      .get();

    articles = snapshot.docs.map((doc) => {
      const data = doc.data();
      return {
        id: doc.id,
        slug: data.slug || undefined,
        title: data.title || "",
        description: data.description || "",
        ogp_image: data.ogp_image || "/ogp_default.png",
        tag: data.tag || "",
        created_date:
          data.created_date?.toDate?.()?.toISOString() ||
          data.created_date ||
          "",
        update_date:
          data.update_date?.toDate?.()?.toISOString() || data.update_date || "",
      };
    });
  } catch (err) {
    console.error("Failed to fetch articles:", err);
    // エラーの場合は空の配列を返す
    articles = [];
  }

  // 1ページあたり5件の記事を表示
  return paginate(articles, { pageSize: 5 });
}) satisfies GetStaticPaths;

interface Props {
  page: Page<BlogListItem>;
}

const { page } = Astro.props;
const articles = page.data;
---

<Layout title="muzigen.net">
  <BlogSchema
    name="muzigen.net Blog"
    description="Tech 人生 趣味"
    url={`${Astro.url.origin}/blog`}
    blogPosts={articles}
  />

  <main id="main-content" class="max-w-7xl mx-auto px-4 py-8 md:py-12">
    <header class="mb-8 md:mb-12 text-center">
      <h1 class="text-3xl md:text-5xl font-bold mb-3 md:mb-4 text-gray-900">
        ブログ記事一覧
      </h1>
      <p class="text-lg md:text-xl text-gray-600 max-w-2xl mx-auto">
        tech life hobby and other things
      </p>
    </header>

    {
      articles.length === 0 ? (
        <EmptyState
          title="記事が見つかりませんでした"
          description="まもなく新しい記事を公開予定です。"
        />
      ) : (
        <>
          <div class="max-w-4xl mx-auto space-y-8">
            {articles.map((article) => (
              <ArticleCard article={article} />
            ))}
          </div>
          <Pagination page={page} />
        </>
      )
    }

    <!-- RSS Feed Link -->
    <div class="mt-12 pt-8 border-t border-gray-200 text-center">
      <p class="text-sm text-gray-500 mb-3">最新記事をフォロー</p>
      <a
        href="/rss.xml"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-orange-600 bg-orange-50 border border-orange-200 rounded-full hover:bg-orange-100 transition-colors"
        aria-label="RSS Feed"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"/>
        </svg>
        RSS Feed
      </a>
    </div>
  </main>
</Layout>
