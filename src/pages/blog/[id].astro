---
import Layout from "../../layouts/Layout.astro";
import type { BlogArticle } from "../../types/blog";
import { getFirestore } from "firebase-admin/firestore";
import { app } from "../../firebase/server";
import { sanitizeHtml } from "../../utils/markdown";
import { createMarkdownProcessor } from "@astrojs/markdown-remark";
import rehypeMermaid from "rehype-mermaid";
import BlogPostingSchema from "../../components/BlogPostingSchema.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import RelatedArticles from "../../components/RelatedArticles.astro";

export async function getStaticPaths() {
	const db = getFirestore(app);
	const processor = await createMarkdownProcessor({
		syntaxHighlight: {
			type: "shiki",
			excludeLangs: ["mermaid"],
		},
		rehypePlugins: [rehypeMermaid],
	});
	try {
		const snapshot = await db
			.collection("blog_contents")
			.where("publish", "==", true)
			.get();

		return Promise.all(
			snapshot.docs.map(async (doc) => {
				const data = doc.data();

				// Process elements and convert markdown to HTML
				const processedElements = await Promise.all(
					(data.elements || []).map(async (element: any) => ({
						source: element.source || "",
						type: element.type || "",
						safeHTML:
							element.type === "markdown" && element.source
								? sanitizeHtml(
										(await processor.render(element.source))
											.code,
									)
								: sanitizeHtml(
										element.safeHTML ||
											element.source ||
											"",
									),
					})),
				);

				const article: BlogArticle = {
					id: doc.id,
					slug: data.slug || undefined,
					title: data.title || "",
					description: data.description || "",
					ogp_image: data.ogp_image || "/ogp_default.png",
					content: data.content
						? sanitizeHtml(
								(await processor.render(data.content)).code,
							)
						: "",
					tag: data.tag || "",
					tags: data.tags || undefined,
					content_url: data.content_url || "",
					markdown_url: data.markdown_url || "",
					update_date:
						data.update_date?.toDate?.()?.toISOString() ||
						data.update_date ||
						"",
					created_date:
						data.created_date?.toDate?.()?.toISOString() ||
						data.created_date ||
						"",
					publish: data.publish || false,
					elements: processedElements,
				};

				return {
					params: { id: data.slug || doc.id },
					props: { article },
				};
			}),
		);
	} catch (error) {
		console.error("Error fetching blog posts:", error);
		return [];
	}
}

const { article } = Astro.props;
---

<Layout
	title={article.title}
	description={article.description}
	ogImage={article.ogp_image}
	ogType="article"
	publishedTime={article.created_date}
	modifiedTime={article.update_date}
>
	<BlogPostingSchema
		title={article.title}
		description={article.description}
		image={article.ogp_image}
		datePublished={article.created_date}
		dateModified={article.update_date || article.created_date}
		url={Astro.url.href}
	/>
	<BreadcrumbSchema
		items={[
			{ name: "ホーム", url: "/" },
			{ name: "ブログ", url: "/blog" },
			{
				name: article.title,
				url: `/blog/${article.slug || article.id}/`,
			},
		]}
	/>

	<main id="main-content" class="max-w-4xl mx-auto px-4 py-12">
		<!-- パンくずナビゲーション -->
		<Breadcrumb
			items={[
				{ name: "ホーム", url: "/" },
				{ name: "ブログ", url: "/blog" },
				{
					name: article.title,
					url: `/blog/${article.slug || article.id}/`,
				},
			]}
		/>

		<article
			class="bg-white rounded-2xl shadow-lg border border-gray-200 overflow-hidden"
		>
			<!-- OGP画像（ある場合は最初に表示） -->
			{
				article.ogp_image && (
					<div class="h-[200px] overflow-hidden bg-gray-100">
						<img
							src={article.ogp_image}
							alt={article.title}
							loading="lazy"
							decoding="async"
							class="w-full h-full object-contain"
						/>
					</div>
				)
			}

			<!-- ヘッダー部分 -->
			<header
				class="px-4 md:px-8 pt-8 md:pt-12 pb-6 md:pb-8 border-b border-gray-100"
			>
				<h1
					class="text-3xl md:text-5xl font-bold text-gray-900 mb-4 md:mb-6 leading-tight"
				>
					{article.title}
				</h1>

				<div
					class="flex flex-wrap items-center gap-4 text-sm md:text-sm text-gray-600 mb-6"
				>
					{
						article.created_date && (
							<time
								datetime={article.created_date}
								class="flex items-center gap-2"
							>
								<svg
									class="w-5 h-5 text-gray-400"
									fill="none"
									stroke="currentColor"
									viewBox="0 0 24 24"
								>
									<path
										stroke-linecap="round"
										stroke-linejoin="round"
										stroke-width="2"
										d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
									/>
								</svg>
								{new Date(
									article.created_date,
								).toLocaleDateString("ja-JP", {
									year: "numeric",
									month: "long",
									day: "numeric",
								})}
							</time>
						)
					}
					{
						article.update_date &&
							article.update_date !== article.created_date && (
								<span class="flex items-center gap-2 text-gray-500">
									<svg
										class="w-5 h-5 text-gray-400"
										fill="none"
										stroke="currentColor"
										viewBox="0 0 24 24"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
										/>
									</svg>
									更新:{" "}
									{new Date(
										article.update_date,
									).toLocaleDateString("ja-JP", {
										year: "numeric",
										month: "short",
										day: "numeric",
									})}
								</span>
							)
					}
				</div>

				{
					article.description && (
						<p class="text-lg md:text-xl text-gray-700 leading-relaxed mb-6 border-l-4 border-blue-500 pl-4 py-2 bg-blue-50/50">
							{article.description}
						</p>
					)
				}

				{
					((article.tags && article.tags.length > 0) ||
						article.tag) && (
						<div class="flex flex-wrap gap-2">
							{article.tags && article.tags.length > 0
								? article.tags.map((tag) => (
										<a
											href={`/tags/${encodeURIComponent(tag)}`}
											class="px-4 py-2 bg-blue-50 text-blue-800 font-medium rounded-full text-sm hover:bg-blue-100 transition-colors inline-flex items-center gap-1"
										>
											<svg
												class="w-4 h-4"
												fill="none"
												stroke="currentColor"
												viewBox="0 0 24 24"
											>
												<path
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="2"
													d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"
												/>
											</svg>
											#{tag}
										</a>
									))
								: article.tag && (
										<a
											href={`/tags/${encodeURIComponent(article.tag)}`}
											class="px-4 py-2 bg-blue-50 text-blue-800 font-medium rounded-full text-sm hover:bg-blue-100 transition-colors inline-flex items-center gap-1"
										>
											<svg
												class="w-4 h-4"
												fill="none"
												stroke="currentColor"
												viewBox="0 0 24 24"
											>
												<path
													stroke-linecap="round"
													stroke-linejoin="round"
													stroke-width="2"
													d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"
												/>
											</svg>
											#{article.tag}
										</a>
									)}
						</div>
					)
				}
			</header>

			<!-- 本文 -->
			<div class="px-4 md:px-8 py-8 md:py-12">
				<div class="markdown-content max-w-none">
					{
						article.content ? (
							<div set:html={article.content} />
						) : article.elements && article.elements.length > 0 ? (
							<div>
								{article.elements.map((element) => (
									<div class="element-content">
										<div set:html={element.safeHTML} />
									</div>
								))}
							</div>
						) : (
							<div class="text-center py-12">
								<div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
									<svg
										class="w-8 h-8 text-gray-400"
										fill="none"
										stroke="currentColor"
										viewBox="0 0 24 24"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
										/>
									</svg>
								</div>
								<p class="text-gray-500">
									コンテンツがありません
								</p>
							</div>
						)
					}
				</div>

				<!-- シェアボタン -->
				<ShareButtons url={Astro.url.href} title={article.title} />

				<!-- 関連記事 -->
				{
					article.tag && (
						<RelatedArticles
							currentArticleId={article.id}
							tag={article.tag}
							limit={3}
						/>
					)
				}
			</div>

			<!-- フッター -->
			<footer
				class="px-4 md:px-8 py-4 md:py-6 bg-gray-50 border-t border-gray-200"
			>
				<div class="flex items-center justify-between flex-wrap gap-4">
					<div class="text-sm text-gray-600">
						この記事は役に立ちましたか？
					</div>
					<div class="flex items-center gap-4">
						{
							article.markdown_url && (
								<a
									href={article.markdown_url}
									target="_blank"
									rel="noopener noreferrer"
									class="inline-flex items-center gap-2 text-gray-600 hover:text-gray-900 font-medium transition-colors"
								>
									<svg
										class="w-4 h-4"
										fill="none"
										stroke="currentColor"
										viewBox="0 0 24 24"
									>
										<path
											stroke-linecap="round"
											stroke-linejoin="round"
											stroke-width="2"
											d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
										/>
									</svg>
									Markdown を表示
								</a>
							)
						}
						<a
							href="/blog"
							class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-800 font-medium transition-colors"
						>
							他の記事を読む
							<svg
								class="w-4 h-4"
								fill="none"
								stroke="currentColor"
								viewBox="0 0 24 24"
							>
								<path
									stroke-linecap="round"
									stroke-linejoin="round"
									stroke-width="2"
									d="M9 5l7 7-7 7"></path>
							</svg>
						</a>
					</div>
				</div>
			</footer>
		</article>

		<!-- RSS Feed Link -->
		<div class="mt-8 text-center">
			<p class="text-sm text-gray-500 mb-3">最新記事をフォロー</p>
			<a
				href="/rss.xml"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-orange-700 bg-orange-50 border border-orange-200 rounded-full hover:bg-orange-100 transition-colors"
				aria-label="RSS Feed"
			>
				<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
					<path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1Z"/>
				</svg>
				RSS Feed
			</a>
		</div>
	</main>
</Layout>

<style is:global>
	/* Markdown content styles - Inspired by Atlassian Design System */
	.markdown-content {
		/* Mapping legacy variables to new theme or hardcoded values */
		--font-heading-xlarge: 2.5rem;
		--font-heading-large: 2rem;
		--font-heading-medium: 1.75rem;
		--font-heading-small: 1.5rem;

		--font-body-large: 1.125rem;
		--font-body-medium: 1rem;
		--font-body-small: 0.875rem;

		--line-height-heading: 1.3;
		--line-height-body: 1.6;

		--color-text-primary: var(--text-main /* #111827 */);
		--color-text-secondary: #4b5563;

		--color-link-default: var(--neon-cyan);
		--color-link-hover: var(--neon-magenta);

		--color-border-default: #e5e7eb;
		--color-border-subtle: #f3f4f6;
		--color-border-focus: var(--neon-cyan);

		--color-surface-raised: #f9fafb;

		--color-gray-50: #f9fafb;
		--color-gray-100: #f3f4f6;
		--color-gray-900: #111827;

		--color-blue-600: var(--neon-cyan);

		--spacing-050: 0.125rem;
		--spacing-100: 0.25rem;
		--spacing-200: 0.5rem;
		--spacing-300: 0.75rem;
		--spacing-400: 1rem;
		--spacing-500: 1.25rem;
		--spacing-600: 1.5rem;

		--radius-small: 0.25rem;
		--radius-medium: 0.5rem;

		--shadow-raised: 0 1px 2px 0 rgba(0, 0, 0, 0.05);

		font-size: var(--font-body-medium);
		color: var(--color-text-primary);
		line-height: var(--line-height-body);
	}

	/* Headings - Using design tokens */
	.markdown-content h1,
	.markdown-content h2,
	.markdown-content h3,
	.markdown-content h4,
	.markdown-content h5,
	.markdown-content h6 {
		font-weight: 700;
		color: var(--color-text-primary);
		line-height: var(--line-height-heading);
		scroll-margin-top: var(--spacing-400);
	}

	.markdown-content h1 {
		font-size: var(--font-heading-xlarge);
		margin-top: var(--spacing-600);
		margin-bottom: var(--spacing-400);
	}

	.markdown-content h2 {
		font-size: var(--font-heading-large);
		margin-top: var(--spacing-500);
		margin-bottom: var(--spacing-300);
		padding-bottom: var(--spacing-200);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.markdown-content h3 {
		font-size: var(--font-heading-medium);
		margin-top: var(--spacing-400);
		margin-bottom: var(--spacing-300);
	}

	.markdown-content h4 {
		font-size: var(--font-heading-small);
		margin-top: var(--spacing-400);
		margin-bottom: var(--spacing-200);
	}

	.markdown-content h5,
	.markdown-content h6 {
		font-size: var(--font-body-large);
		margin-top: var(--spacing-300);
		margin-bottom: var(--spacing-200);
	}

	/* Paragraphs */
	.markdown-content p {
		margin-bottom: var(--spacing-300);
		color: var(--color-text-primary);
		font-size: var(--font-body-medium);
		line-height: var(--line-height-body);
	}

	/* Lists */
	.markdown-content ul,
	.markdown-content ol {
		margin-bottom: var(--spacing-300);
		padding-left: var(--spacing-400);
	}

	.markdown-content ul {
		list-style-type: disc;
	}

	.markdown-content ol {
		list-style-type: decimal;
	}

	.markdown-content li {
		margin-bottom: var(--spacing-100);
		color: var(--color-text-primary);
		line-height: var(--line-height-body);
	}

	.markdown-content li > p {
		margin-bottom: var(--spacing-100);
	}

	/* Nested lists */
	.markdown-content ul ul,
	.markdown-content ol ul,
	.markdown-content ul ol,
	.markdown-content ol ol {
		margin-top: var(--spacing-100);
		margin-bottom: var(--spacing-100);
	}

	/* Blockquotes */
	.markdown-content blockquote {
		border-left: 4px solid var(--color-blue-600);
		padding: var(--spacing-200) var(--spacing-300);
		margin: var(--spacing-400) 0;
		background-color: var(--color-surface-raised);
		border-radius: var(--radius-medium);
		color: var(--color-text-secondary);
	}

	.markdown-content blockquote p:last-child {
		margin-bottom: 0;
	}

	/* Inline code */
	.markdown-content code {
		background-color: var(--color-gray-100);
		padding: var(--spacing-050) var(--spacing-100);
		border-radius: var(--radius-small);
		font-size: var(--font-body-small);
		font-family: var(--font-family-mono);
		color: #d73a49;
		font-weight: 500;
	}

	/* Code blocks */
	.markdown-content pre {
		background-color: var(--color-gray-900);
		color: var(--color-gray-50);
		padding: var(--spacing-300);
		border-radius: var(--radius-medium);
		overflow-x: auto;
		margin: var(--spacing-400) 0;
		box-shadow: var(--shadow-raised);
		max-width: 100%;
		-webkit-overflow-scrolling: touch;
	}

	.markdown-content pre code {
		background-color: transparent;
		padding: 0;
		color: inherit;
		font-weight: normal;
	}

	/* Tables */
	.markdown-content table {
		width: 100%;
		border-collapse: collapse;
		border: 1px solid var(--color-border-default);
		margin: var(--spacing-400) 0;
		border-radius: var(--radius-medium);
		overflow: hidden;
		display: block;
		overflow-x: auto;
		-webkit-overflow-scrolling: touch;
	}

	.markdown-content th,
	.markdown-content td {
		border: 1px solid var(--color-border-default);
		padding: var(--spacing-200);
		text-align: left;
	}

	.markdown-content th {
		background-color: var(--color-surface-raised);
		font-weight: 600;
		color: var(--color-text-primary);
	}

	.markdown-content tr:hover {
		background-color: var(--color-surface-raised);
	}

	/* Links */
	.markdown-content a {
		color: var(--color-link-default);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 2px;
		transition: color 0.2s ease;
		word-break: break-word;
	}

	.markdown-content a:hover {
		color: var(--color-link-hover);
		text-decoration-thickness: 2px;
	}

	.markdown-content a:focus-visible {
		outline: 2px solid var(--color-border-focus);
		outline-offset: 2px;
		border-radius: var(--radius-small);
	}

	/* Images */
	.markdown-content img {
		max-width: 100%;
		height: auto;
		border-radius: var(--radius-medium);
		box-shadow: var(--shadow-raised);
		margin: var(--spacing-400) 0;
	}

	/* Horizontal rule */
	.markdown-content hr {
		border: none;
		border-top: 2px solid var(--color-border-default);
		margin: var(--spacing-600) 0;
	}

	/* Strong/Bold */
	.markdown-content strong,
	.markdown-content b {
		font-weight: 700;
		color: var(--color-text-primary);
	}

	/* Emphasis/Italic */
	.markdown-content em,
	.markdown-content i {
		font-style: italic;
	}

	/* First paragraph special styling */
	.markdown-content > p:first-of-type {
		font-size: var(--font-body-large);
		color: var(--color-text-secondary);
	}

	/* Element content styling */
	.element-content {
		margin-bottom: var(--spacing-300);
	}
</style>
