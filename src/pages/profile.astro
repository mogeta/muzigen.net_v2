---
import Layout from "../layouts/Layout.astro";
import PersonSchema from "../components/PersonSchema.astro";
import BreadcrumbSchema from "../components/BreadcrumbSchema.astro";
import { LinkPreview } from "astro-embed";

const profile = {
  name: "muzigen",
  bio:
    "Game Developer & Web Engineer. プロジェクトや活動のまとめ",
  image: "/favicon.svg",
};
---

<Layout title="プロフィール" description={profile.bio} ogType="profile">
  <PersonSchema
    name={profile.name}
    description={profile.bio}
    image={profile.image}
    url="/profile"
    sameAs={[]}
  />
  <BreadcrumbSchema
    items={[
      { name: "ホーム", url: "/" },
      { name: "プロフィール", url: "/profile" },
    ]}
  />

  <main id="main-content" class="max-w-7xl mx-auto px-4 py-12">
    <section class="bg-white rounded-2xl shadow-lg border border-gray-200 p-8">
      <div class="flex flex-col md:flex-row items-center md:items-start gap-6">
        <div class="flex-shrink-0">
          <img
            src={profile.image}
            alt={profile.name}
            class="w-24 h-24 rounded-full border-4 border-blue-100 shadow-lg object-cover"
          />
        </div>
        <div class="flex-1 text-center md:text-left">
          <h1 class="text-3xl font-bold text-gray-900 mb-3">{profile.name}</h1>
          <p class="text-lg text-gray-700 leading-relaxed mb-6">
            {profile.bio}
          </p>
          <div class="flex flex-wrap gap-3 justify-center md:justify-start mb-8">
            <a
              href="https://github.com/mogeta"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 bg-gray-50 text-gray-700 rounded-lg hover:bg-gray-100 transition-colors font-medium"
              aria-label="GitHubプロフィールを見る"
            >
              <svg
                class="w-5 h-5"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
              </svg>
              GitHub
            </a>
            <a
              href="/profile/lapras"
              class="inline-flex items-center gap-2 px-4 py-2 bg-purple-50 text-purple-800 rounded-lg hover:bg-purple-100 transition-colors font-medium"
            >
              LAPRASデータを見る
            </a>
          </div>
          <div class="mt-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-3">
              関わったProject
            </h2>
            <ul class="space-y-4 md:space-y-0 md:grid md:grid-cols-3 md:gap-6 text-gray-700 leading-relaxed">
              <li>
                <div class="h-full p-5 border border-gray-200 rounded-xl bg-white shadow-sm">
                  <LinkPreview
                    id="https://opensea.io/item/ethereum/0x47474caa8383e015c0b3f22b2ae2fd8b794e4c8e/1"
                  />
                  <p class="text-gray-700 mt-3">
                    ジェネラーティブアートのエンジニアリングを担当しました。
                  </p>
                </div>
              </li>
              <li>
                <div class="h-full p-5 border border-gray-200 rounded-xl bg-white shadow-sm">
                  <LinkPreview id="https://bravefrontierheroes.com/ja" />
                  <p class="text-gray-700 mt-3">
                    マネージメント、開発ディレクション全般に関わりました。
                  </p>
                </div>
              </li>
              <li>
                <div class="h-full p-5 border border-gray-200 rounded-xl bg-white shadow-sm">
                  <LinkPreview
                    id="https://alabaster-gazelle-9ba.notion.site/Brave-Frontier-Heroes-Developer-Documentation-Forge-API-2d8bb46579d180bdafe0c9fb28d1cc83"
                  />
                  <p class="text-gray-700 mt-3">
                    ブレヒロAPIの設計、実装、リリースを担当しました。
                  </p>
                </div>
              </li>
              <li>
                <div class="h-full p-5 border border-gray-200 rounded-xl bg-white shadow-sm">
                  <LinkPreview
                    id="https://cedec.cesa.or.jp/2020/session/detail/s5e82a55322244.html"
                  />
                  <p class="text-gray-700 mt-3">CEDEC2020に登壇しました。</p>
                </div>
              </li>
              <li>
                <div class="h-full p-5 border border-gray-200 rounded-xl bg-white shadow-sm">
                  <LinkPreview
                    id="https://speakerdeck.com/mogeta/why-dont-you-measure-your-performance"
                  />
                  <p class="text-gray-700 mt-3">builderscon2018に登壇しました。</p>
                </div>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
