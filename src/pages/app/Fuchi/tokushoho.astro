---
const target = "/app/Fuchi/ja/commercial-transactions";
const canonicalURL = `${Astro.site?.origin ?? Astro.url.origin}${target}`;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta http-equiv="refresh" content={`0;url=${target}`} />
		<link rel="canonical" href={canonicalURL} />
		<title>特定商取引法に基づく表記へ移動します</title>
	</head>
	<body>
		<p><a href={target}>特定商取引法に基づく表記へ移動します。</a></p>
		<script is:inline>
			location.replace("/app/Fuchi/ja/commercial-transactions");
		</script>
	</body>
</html>
