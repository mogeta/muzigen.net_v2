---
import Layout from "../../layouts/Layout.astro";
import PersonSchema from "../../components/PersonSchema.astro";
import BreadcrumbSchema from "../../components/BreadcrumbSchema.astro";
import {
  fetchLaprasProfile,
  formatScore,
  getScoreColor,
  getScoreBgColor,
} from "../../lib/lapras";

// Laprasデータを取得
const laprasShareId = import.meta.env.LAPRAS_SHARE_ID;
const laprasData = laprasShareId
  ? await fetchLaprasProfile(laprasShareId)
  : null;

// プロフィール情報（Laprasデータまたはフォールバック）
const profile = {
  name: laprasData?.name || "muzigen",
  userName: laprasData?.user_name || "mogeta",
  bio:
    laprasData?.description ||
    "Web開発やブロックチェーン技術に興味を持つエンジニアです。このサイトでは技術的な知見や学んだことを共有しています。",
  image: laprasData?.icon_url || "/favicon.svg",
  email: "", // 公開したい場合は設定してください
  social: {
    twitter: "", // 例: 'https://twitter.com/username'
    github: `https://github.com/${laprasData?.user_name || ""}`,
    lapras: laprasShareId ? `https://lapras.com/public/${laprasShareId}` : "",
  },
};

const sameAs = Object.values(profile.social).filter((link) => link);

// デバッグ: Laprasデータの確認
console.log("Lapras Share ID:", laprasShareId);
console.log("Lapras Data loaded:", !!laprasData);
if (laprasData) {
  console.log(
    "GitHub Repositories count:",
    laprasData.github_repositories?.length || 0,
  );
  console.log("Articles - Qiita:", laprasData.qiita_articles?.length || 0);
  console.log("Articles - Zenn:", laprasData.zenn_articles?.length || 0);
  console.log("Articles - Blog:", laprasData.blog_articles?.length || 0);
  console.log(
    "Speaker Deck Slides:",
    laprasData.speaker_deck_slides?.length || 0,
  );
}

// GitHubリポジトリ（上位10件、フォークを除外）
const topRepositories =
  laprasData?.github_repositories
    ?.filter((repo) => !repo.is_fork)
    .sort((a, b) => (b.stargazers_count || 0) - (a.stargazers_count || 0))
    .slice(0, 10) || [];

console.log("Top Repositories count:", topRepositories.length);

// 記事（各ソースから最新5件）
const allArticles = [
  ...(laprasData?.qiita_articles?.slice(0, 5) || []).map((a) => ({
    ...a,
    source: "Qiita",
  })),
  ...(laprasData?.zenn_articles?.slice(0, 5) || []).map((a) => ({
    ...a,
    source: "Zenn",
  })),
  ...(laprasData?.blog_articles?.slice(0, 5) || []).map((a) => ({
    ...a,
    source: "Blog",
  })),
  ...(laprasData?.note_articles?.slice(0, 5) || []).map((a) => ({
    ...a,
    source: "Note",
  })),
]
  .sort(
    (a, b) =>
      new Date(b.published_at).getTime() - new Date(a.published_at).getTime(),
  )
  .slice(0, 10);

console.log("All Articles count:", allArticles.length);

// スピーカー活動（上位5件）
const topSlides =
  laprasData?.speaker_deck_slides
    ?.sort((a, b) => (b.views_count || 0) - (a.views_count || 0))
    .slice(0, 5) || [];

console.log("Top Slides count:", topSlides.length);
---

<Layout title="プロフィール（LAPRAS）" description={profile.bio} ogType="profile">
  <PersonSchema
    name={profile.name}
    description={profile.bio}
    image={profile.image}
    url="/profile/lapras"
    sameAs={sameAs}
  />
  <BreadcrumbSchema
    items={[
      { name: "ホーム", url: "/" },
      { name: "プロフィール", url: "/profile" },
      { name: "LAPRAS", url: "/profile/lapras" },
    ]}
  />

  <main id="main-content" class="max-w-4xl mx-auto px-4 py-12">
    <!-- 戻るナビゲーション -->
    <nav class="mb-8" aria-label="パンくずリスト">
      <a
        href="/profile"
        class="inline-flex items-center gap-2 text-gray-600 hover:text-gray-900 font-medium transition-colors px-3 py-2 rounded-lg hover:bg-gray-100"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 19l-7-7 7-7"
          ></path>
        </svg>
        プロフィールに戻る
      </a>
    </nav>

    <article
      class="bg-white rounded-2xl shadow-lg border border-gray-200 overflow-hidden"
    >
      <!-- プロフィールヘッダー -->
      <div class="px-8 pt-12 pb-8 border-b border-gray-100">
        <div
          class="flex flex-col md:flex-row items-center md:items-start gap-6"
        >
          <!-- プロフィール画像 -->
          <div class="flex-shrink-0">
            <img
              src={profile.image}
              alt={profile.name}
              class="w-32 h-32 rounded-full border-4 border-blue-100 shadow-lg object-cover"
            />
          </div>

          <!-- 基本情報 -->
          <div class="flex-1 text-center md:text-left">
            <h1 class="text-4xl font-bold text-gray-900 mb-4">
              {profile.name}
            </h1>
            <p class="text-lg text-gray-700 leading-relaxed mb-6">
              {profile.bio}
            </p>

            <!-- SNSリンク -->
            {
              sameAs.length > 0 && (
                <div class="flex flex-wrap gap-3 justify-center md:justify-start">
                  {profile.social.twitter && (
                    <a
                      href={profile.social.twitter}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 px-4 py-2 bg-blue-50 text-blue-800 rounded-lg hover:bg-blue-100 transition-colors font-medium"
                      aria-label="Twitterプロフィールを見る"
                    >
                      <svg
                        class="w-5 h-5"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                      </svg>
                      Twitter
                    </a>
                  )}
                  {profile.social.github && (
                    <a
                      href="https://github.com/mogeta"
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 px-4 py-2 bg-gray-50 text-gray-700 rounded-lg hover:bg-gray-100 transition-colors font-medium"
                      aria-label="GitHubプロフィールを見る"
                    >
                      <svg
                        class="w-5 h-5"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                      </svg>
                      GitHub
                    </a>
                  )}
                  {profile.social.lapras && (
                    <a
                      href={profile.social.lapras}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 px-4 py-2 bg-purple-50 text-purple-800 rounded-lg hover:bg-purple-100 transition-colors font-medium"
                      aria-label="Laprasプロフィールを見る"
                    >
                      <svg
                        class="w-5 h-5"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                      >
                        <path d="M12 2L2 7v10c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5z" />
                      </svg>
                      LAPRAS
                    </a>
                  )}
                </div>
              )
            }
          </div>
        </div>
      </div>

      <!-- スキルスコア -->
      {
        laprasData && (
          <div class="px-8 py-8 border-b border-gray-100">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">スキルスコア</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              <div
                class={`p-6 rounded-xl ${getScoreBgColor(laprasData.e_score)} border border-gray-200`}
              >
                <div class="text-sm font-medium text-gray-600 mb-2">
                  Engineering Score
                </div>
                <div
                  class={`text-4xl font-bold ${getScoreColor(laprasData.e_score)}`}
                >
                  {formatScore(laprasData.e_score)}
                  <span class="text-2xl text-gray-400 ml-1">/5</span>
                </div>
                <div class="text-xs text-gray-500 mt-2">技術力スコア</div>
              </div>
              <div
                class={`p-6 rounded-xl ${getScoreBgColor(laprasData.b_score)} border border-gray-200`}
              >
                <div class="text-sm font-medium text-gray-600 mb-2">
                  Business Score
                </div>
                <div
                  class={`text-4xl font-bold ${getScoreColor(laprasData.b_score)}`}
                >
                  {formatScore(laprasData.b_score)}
                  <span class="text-2xl text-gray-400 ml-1">/5</span>
                </div>
                <div class="text-xs text-gray-500 mt-2">ビジネス力スコア</div>
              </div>
              <div
                class={`p-6 rounded-xl ${getScoreBgColor(laprasData.i_score)} border border-gray-200`}
              >
                <div class="text-sm font-medium text-gray-600 mb-2">
                  Influence Score
                </div>
                <div
                  class={`text-4xl font-bold ${getScoreColor(laprasData.i_score)}`}
                >
                  {formatScore(laprasData.i_score)}
                  <span class="text-2xl text-gray-400 ml-1">/5</span>
                </div>
                <div class="text-xs text-gray-500 mt-2">影響力スコア</div>
              </div>
            </div>
          </div>
        )
      }

      <!-- GitHubリポジトリ -->
      {
        topRepositories.length > 0 && (
          <div class="px-8 py-8 border-b border-gray-100">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">
              主要リポジトリ
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              {topRepositories.map((repo) => (
                <a
                  href={repo.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="p-5 border border-gray-200 rounded-lg hover:border-blue-300 hover:bg-blue-50/50 transition-all group"
                >
                  <div class="flex items-start justify-between mb-2">
                    <h3 class="font-semibold text-gray-900 group-hover:text-blue-600 transition-colors">
                      {repo.title}
                    </h3>
                    {repo.language && (
                      <span class="text-xs px-2 py-1 bg-gray-100 text-gray-700 rounded-full">
                        {repo.language}
                      </span>
                    )}
                  </div>
                  {repo.description && (
                    <p class="text-sm text-gray-600 mb-3 line-clamp-2">
                      {repo.description}
                    </p>
                  )}
                  <div class="flex items-center gap-4 text-xs text-gray-500">
                    <span class="flex items-center gap-1">
                      <svg
                        class="w-4 h-4"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path d="M12 2l2.4 7.4h7.6l-6 4.6 2.3 7-6.3-4.6-6.3 4.6 2.3-7-6-4.6h7.6z" />
                      </svg>
                      {repo.stargazers_count || 0}
                    </span>
                    <span class="flex items-center gap-1">
                      <svg
                        class="w-4 h-4"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path d="M8 6.1V3h8v3.1l6 3V21H2V9.1l6-3zM4 11v8h16v-8l-8-4.5L4 11z" />
                      </svg>
                      {repo.forks || 0}
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )
      }

      <!-- 技術記事 -->
      {
        allArticles.length > 0 && (
          <div class="px-8 py-8 border-b border-gray-100">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">技術記事</h2>
            <div class="space-y-4">
              {allArticles.map((article) => (
                <a
                  href={article.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block p-4 border border-gray-200 rounded-lg hover:border-blue-300 hover:bg-blue-50/50 transition-all group"
                >
                  <div class="flex items-start justify-between gap-3">
                    <div class="flex-1 min-w-0">
                      <h3 class="font-semibold text-gray-900 group-hover:text-blue-600 transition-colors mb-2 line-clamp-2">
                        {article.title}
                      </h3>
                      <div class="flex items-center gap-3 text-xs text-gray-500">
                        <span class="px-2 py-1 bg-gray-100 text-gray-700 rounded-full font-medium">
                          {article.source}
                        </span>
                        <time>
                          {new Date(article.published_at).toLocaleDateString(
                            "ja-JP",
                          )}
                        </time>
                        {article.likes_count !== undefined &&
                          article.likes_count > 0 && (
                            <span class="flex items-center gap-1">
                              <svg
                                class="w-3 h-3"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                              >
                                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z" />
                              </svg>
                              {article.likes_count}
                            </span>
                          )}
                      </div>
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )
      }

      <!-- スピーカー活動 -->
      {
        topSlides.length > 0 && (
          <div class="px-8 py-8 border-b border-gray-100">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">
              スピーカー活動
            </h2>
            <div class="space-y-4">
              {topSlides.map((slide) => (
                <a
                  href={slide.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block p-4 border border-gray-200 rounded-lg hover:border-blue-300 hover:bg-blue-50/50 transition-all group"
                >
                  <h3 class="font-semibold text-gray-900 group-hover:text-blue-600 transition-colors mb-2">
                    {slide.title}
                  </h3>
                  <div class="flex items-center gap-4 text-xs text-gray-500">
                    <time>
                      {new Date(slide.published_at).toLocaleDateString("ja-JP")}
                    </time>
                    <span class="flex items-center gap-1">
                      <svg
                        class="w-4 h-4"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z" />
                      </svg>
                      {(slide.views_count || 0).toLocaleString()}
                    </span>
                    <span class="flex items-center gap-1">
                      <svg
                        class="w-4 h-4"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path d="M12 2l2.4 7.4h7.6l-6 4.6 2.3 7-6.3-4.6-6.3 4.6 2.3-7-6-4.6h7.6z" />
                      </svg>
                      {slide.stars_count || 0}
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )
      }

      <!-- 追加情報セクション（必要に応じてカスタマイズ） -->
      <div class="px-8 py-12">
        <div class="prose prose-lg max-w-none">
          <h2 class="text-2xl font-bold text-gray-900 mb-4">
            このサイトについて
          </h2>
          <p class="text-gray-700 leading-relaxed mb-6">
            muzigen.netでは、Web開発、Astro、Firebase、ブロックチェーン技術などに関する技術記事を投稿しています。
            実際に開発で遭遇した問題の解決方法や、新しく学んだ技術の知見を共有することで、
            同じような課題に直面している方の助けになれば幸いです。
          </p>

          {
            profile.email && (
              <div class="mt-8">
                <h2 class="text-2xl font-bold text-gray-900 mb-4">
                  お問い合わせ
                </h2>
                <p class="text-gray-700 leading-relaxed">
                  ご質問やご意見がありましたら、お気軽にご連絡ください。
                </p>
                <a
                  href={`mailto:${profile.email}`}
                  class="inline-flex items-center gap-2 mt-4 px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium"
                >
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                    />
                  </svg>
                  メールを送る
                </a>
              </div>
            )
          }
        </div>
      </div>

      <!-- フッター -->
      <footer class="px-8 py-6 bg-gray-50 border-t border-gray-200">
        <div class="flex items-center justify-between flex-wrap gap-4">
          <div class="text-sm text-gray-600">記事一覧もぜひご覧ください</div>
          <div class="flex gap-4">
            <a
              href="/blog"
              class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-800 font-medium transition-colors"
            >
              ブログ記事を読む
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                ></path>
              </svg>
            </a>
            <a
              href="/posts"
              class="inline-flex items-center gap-2 text-blue-600 hover:text-blue-800 font-medium transition-colors"
            >
              技術記事を読む
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 5l7 7-7 7"
                ></path>
              </svg>
            </a>
          </div>
        </div>
      </footer>
    </article>
  </main>
</Layout>

<style>
  .prose h2 {
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose p {
    margin-bottom: 1rem;
  }
</style>
