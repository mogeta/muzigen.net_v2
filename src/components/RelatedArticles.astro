---
import ArticleCard from './ArticleCard.astro';
import type {BlogListItem} from '../types/blog';
import {getFirestore} from 'firebase-admin/firestore';
import {app} from '../firebase/server';

interface Props {
  currentArticleId: string;
  tag: string;
  limit?: number;
}

const { currentArticleId, tag, limit = 3 } = Astro.props;

let relatedArticles: BlogListItem[] = [];

try {
  if (tag) {
    const db = getFirestore(app);
    const snapshot = await db.collection('blog_contents')
      .where('publish', '==', true)
      .where('tag', '==', tag)
      .get();

    relatedArticles = snapshot.docs
      .filter(doc => doc.id !== currentArticleId) // Exclude current article
      .map(doc => {
        const data = doc.data();
        return {
          id: doc.id,
          slug: data.slug || undefined,
          title: data.title || '',
          description: data.description || '',
          ogp_image: data.ogp_image || '',
          tag: data.tag || '',
          update_date: data.update_date?.toDate?.()?.toISOString() || data.update_date || '',
          created_date: data.created_date?.toDate?.()?.toISOString() || data.created_date || '',
        };
      })
      .sort((a, b) => {
        // Sort by created_date descending
        const dateA = new Date(a.created_date).getTime();
        const dateB = new Date(b.created_date).getTime();
        return dateB - dateA;
      })
      .slice(0, limit); // Limit results
  }
} catch (error) {
  console.error('Error fetching related articles:', error);
}
---

{relatedArticles.length > 0 && (
  <section class="related-articles" aria-labelledby="related-articles-heading">
    <header class="related-articles-header">
      <h2 id="related-articles-heading" class="related-articles-title">
        関連記事
      </h2>
      <p class="related-articles-subtitle">
        #{tag} の他の記事
      </p>
    </header>

    <div class="related-articles-grid">
      {relatedArticles.map((article) => (
        <ArticleCard article={article} />
      ))}
    </div>

    <div class="related-articles-footer">
      <a
        href={`/tags/${encodeURIComponent(tag)}`}
        class="view-all-link"
      >
        #{tag} の記事をすべて見る
        <svg class="arrow-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </section>
)}

<style>
  .related-articles {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 2px solid #e5e7eb;
  }

  .related-articles-header {
    margin-bottom: 2rem;
    text-align: center;
  }

  .related-articles-title {
    font-size: 2rem;
    font-weight: 700;
    color: #111827;
    margin-bottom: 0.5rem;
  }

  .related-articles-subtitle {
    font-size: 1rem;
    color: #6b7280;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .related-articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .related-articles-footer {
    text-align: center;
    margin-top: 2rem;
  }

  .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background-color: #eff6ff;
    color: #2563eb;
    font-weight: 600;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .view-all-link:hover {
    background-color: #dbeafe;
    transform: translateY(-2px);
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  .view-all-link:focus-visible {
    outline: 2px solid #2563eb;
    outline-offset: 2px;
  }

  .arrow-icon {
    width: 1.25rem;
    height: 1.25rem;
    transition: transform 0.2s ease;
  }

  .view-all-link:hover .arrow-icon {
    transform: translateX(4px);
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .related-articles {
      margin-top: 3rem;
      padding-top: 2rem;
    }

    .related-articles-title {
      font-size: 1.75rem;
    }

    .related-articles-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .related-articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
