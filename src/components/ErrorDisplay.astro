---
interface Props {
  title?: string;
  message: string;
  hint?: string;
  variant?: 'error' | 'warning' | 'info';
}

const {
  title = 'エラーが発生しました',
  message,
  hint,
  variant = 'error'
} = Astro.props;

const variantStyles = {
  error: {
    container: 'bg-red-50 border-red-200',
    iconBg: 'bg-red-100',
    iconColor: 'text-red-600',
    titleColor: 'text-red-900',
    messageColor: 'text-red-700',
    hintColor: 'text-red-600',
    iconPath: 'M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  warning: {
    container: 'bg-yellow-50 border-yellow-200',
    iconBg: 'bg-yellow-100',
    iconColor: 'text-yellow-600',
    titleColor: 'text-yellow-900',
    messageColor: 'text-yellow-700',
    hintColor: 'text-yellow-600',
    iconPath: 'M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
  info: {
    container: 'bg-blue-50 border-blue-200',
    iconBg: 'bg-blue-100',
    iconColor: 'text-blue-600',
    titleColor: 'text-blue-900',
    messageColor: 'text-blue-700',
    hintColor: 'text-blue-600',
    iconPath: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  },
};

const styles = variantStyles[variant];
---

<div class={`max-w-2xl mx-auto text-center border p-8 rounded-xl ${styles.container}`}>
  <div class={`w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-4 ${styles.iconBg}`}>
    <svg class={`w-6 h-6 ${styles.iconColor}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d={styles.iconPath}
      />
    </svg>
  </div>
  <h2 class={`text-xl font-bold mb-2 ${styles.titleColor}`}>{title}</h2>
  <p class={`mb-1 ${styles.messageColor}`}>{message}</p>
  {hint && <p class={`text-sm ${styles.hintColor}`}>{hint}</p>}
</div>
