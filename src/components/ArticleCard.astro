---
import type { BlogListItem } from '../types/blog';

interface Props {
  article: BlogListItem;
}

const { article } = Astro.props;
---

<article class="group relative bg-white border border-gray-200 rounded-xl overflow-hidden hover:shadow-xl hover:border-blue-300 transition-all duration-300">
  {article.ogp_image && (
    <div class="aspect-video overflow-hidden bg-gray-100">
      <img
        src={article.ogp_image}
        alt={article.title}
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      />
    </div>
  )}
  <div class="p-6">
    <header class="mb-4">
      <h2 class="text-2xl font-bold text-gray-900 mb-3 group-hover:text-blue-600 transition-colors line-clamp-2">
        <a
          href={`/blog/${article.slug || article.id}`}
          class="before:absolute before:inset-0 focus:outline-none"
          aria-label={`記事を読む: ${article.title}`}
        >
          {article.title}
        </a>
      </h2>
      {article.description && (
        <p class="text-gray-600 line-clamp-3 leading-relaxed">
          {article.description}
        </p>
      )}
    </header>
    <footer class="flex items-center justify-between text-sm flex-wrap gap-3">
      <div class="flex items-center gap-3 flex-wrap">
        {article.tag && (
          <a
            href={`/tags/${encodeURIComponent(article.tag)}`}
            class="relative z-10 px-3 py-1 bg-blue-50 text-blue-700 rounded-full font-medium text-xs hover:bg-blue-100 transition-colors inline-flex items-center gap-1"
          >
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
            </svg>
            {article.tag}
          </a>
        )}
        {article.created_date && (
          <time datetime={article.created_date} class="text-gray-500 flex items-center gap-1">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
            {new Date(article.created_date).toLocaleDateString('ja-JP', {
              year: 'numeric',
              month: 'short',
              day: 'numeric'
            })}
          </time>
        )}
      </div>
      <span class="text-blue-600 font-medium text-sm flex items-center gap-1 group-hover:gap-2 transition-all">
        続きを読む
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </span>
    </footer>
  </div>
</article>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Enhanced focus state for the card link */
  article:focus-within {
    outline: 2px solid var(--color-border-focus);
    outline-offset: 2px;
  }
</style>