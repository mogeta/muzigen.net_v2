---
import type { Page } from 'astro';

interface Props {
  page: Page<any>;
  baseUrl?: string;
}

const { page, baseUrl = '/blog' } = Astro.props;

// ページ番号の配列を生成（最大7個表示）
function getPageNumbers(currentPage: number, lastPage: number): (number | string)[] {
  const pages: (number | string)[] = [];

  if (lastPage <= 7) {
    // 7ページ以下なら全て表示
    for (let i = 1; i <= lastPage; i++) {
      pages.push(i);
    }
  } else {
    // 常に最初のページを表示
    pages.push(1);

    if (currentPage > 3) {
      pages.push('...');
    }

    // 現在のページ周辺を表示
    const start = Math.max(2, currentPage - 1);
    const end = Math.min(lastPage - 1, currentPage + 1);

    for (let i = start; i <= end; i++) {
      pages.push(i);
    }

    if (currentPage < lastPage - 2) {
      pages.push('...');
    }

    // 常に最後のページを表示
    pages.push(lastPage);
  }

  return pages;
}

const pageNumbers = getPageNumbers(page.currentPage, page.lastPage);

function getPageUrl(pageNum: number): string {
  if (pageNum === 1) {
    return baseUrl;
  }
  return `${baseUrl}/${pageNum}`;
}
---

{page.lastPage > 1 && (
  <nav aria-label="ページネーション" class="flex justify-center items-center gap-2 mt-12">
    {/* 前へボタン */}
    {page.url.prev ? (
      <a
        href={page.url.prev}
        class="px-4 py-2 rounded-lg border border-gray-300 hover:bg-gray-50 transition-colors flex items-center gap-2"
        aria-label="前のページ"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <span class="hidden sm:inline">前へ</span>
      </a>
    ) : (
      <span class="px-4 py-2 rounded-lg border border-gray-200 text-gray-400 cursor-not-allowed flex items-center gap-2">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <span class="hidden sm:inline">前へ</span>
      </span>
    )}

    {/* ページ番号 */}
    <div class="flex gap-2">
      {pageNumbers.map((pageNum) =>
        typeof pageNum === 'number' ? (
          pageNum === page.currentPage ? (
            <span
              class="px-4 py-2 rounded-lg bg-blue-600 text-white font-medium"
              aria-current="page"
            >
              {pageNum}
            </span>
          ) : (
            <a
              href={getPageUrl(pageNum)}
              class="px-4 py-2 rounded-lg border border-gray-300 hover:bg-gray-50 transition-colors"
              aria-label={`ページ${pageNum}へ`}
            >
              {pageNum}
            </a>
          )
        ) : (
          <span class="px-2 py-2 text-gray-400">...</span>
        )
      )}
    </div>

    {/* 次へボタン */}
    {page.url.next ? (
      <a
        href={page.url.next}
        class="px-4 py-2 rounded-lg border border-gray-300 hover:bg-gray-50 transition-colors flex items-center gap-2"
        aria-label="次のページ"
      >
        <span class="hidden sm:inline">次へ</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    ) : (
      <span class="px-4 py-2 rounded-lg border border-gray-200 text-gray-400 cursor-not-allowed flex items-center gap-2">
        <span class="hidden sm:inline">次へ</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </span>
    )}
  </nav>
)}