---
const isProd = import.meta.env.PROD;
const adClient = import.meta.env.PUBLIC_ADSENSE_CLIENT;
const adSlot = import.meta.env.PUBLIC_ADSENSE_SLOT;
const isEnabled = isProd && adClient && adSlot;
---

{isEnabled && (
	<section class="adsense-footer" aria-label="Advertisement">
		<ins
			class="adsbygoogle"
			style="display:block"
			data-ad-client={adClient}
			data-ad-slot={adSlot}
			data-ad-format="auto"
			data-full-width-responsive="true"
		></ins>
	</section>
)}

{isEnabled && (
	<script define:vars={{ adClient }}>
		const scriptSrc = `https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adClient}`;

		// Load the AdSense script immediately
		if (!window.__adsenseLoaded && !window.__adsenseLoading) {
			window.__adsenseLoading = true;

			const script = document.createElement("script");
			script.async = true;
			script.src = scriptSrc;
			script.crossOrigin = "anonymous";
			script.onload = () => {
				window.__adsenseLoaded = true;
				// Initialize the ad
				try {
					(window.adsbygoogle = window.adsbygoogle || []).push({});
				} catch (error) {
					console.warn("AdSense push failed:", error);
				}
			};
			script.onerror = () => {
				window.__adsenseLoading = false;
				console.warn("AdSense script failed to load.");
			};
			document.head.appendChild(script);
		} else if (window.__adsenseLoaded) {
			// If script is already loaded, just push the ad
			try {
				(window.adsbygoogle = window.adsbygoogle || []).push({});
			} catch (error) {
				console.warn("AdSense push failed:", error);
			}
		}
	</script>
)}

<style>
	.adsense-footer {
		min-height: 250px;
		padding: 1.5rem 0 0.5rem;
	}
	.adsense-footer > .adsbygoogle {
		width: 100%;
	}
</style>
