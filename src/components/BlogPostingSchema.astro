---
interface Props {
  title: string;
  description: string;
  image?: string;
  datePublished: string;
  dateModified: string;
  url: string;
  author?: string;
  tags?: string[];
  articleSection?: string;
}

const {
  title,
  description,
  image,
  datePublished,
  dateModified,
  url,
  author,
  tags = [],
  articleSection,
} = Astro.props;

const siteUrl = Astro.url.origin;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description: description,
  image: image ? (image.startsWith('http') ? image : `${siteUrl}${image}`) : undefined,
  datePublished: datePublished,
  dateModified: dateModified,
  inLanguage: 'ja-JP',
  keywords: tags.length > 0 ? tags.join(', ') : undefined,
  articleSection: articleSection || (tags.length > 0 ? tags[0] : 'Blog'),
  author: author ? {
    '@type': 'Person',
    name: author,
  } : {
    '@type': 'Organization',
    name: 'muzigen.net',
  },
  publisher: {
    '@type': 'Organization',
    name: 'muzigen.net',
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/favicon.svg`,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': url,
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
