---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";

const posts = await getCollection("posts");

// 下書きを除外し、公開日で降順ソート
const publishedPosts = posts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout title="記事一覧">
  <main id="main-content" class="max-w-7xl mx-auto px-4 py-12">
    <header class="mb-12 text-center">
      <h1 class="text-5xl font-bold text-gray-900 mb-4">記事一覧</h1>
      <p class="text-xl text-gray-600 max-w-2xl mx-auto">
        Astroマークダウンで書かれた記事の一覧です
      </p>
    </header>

    {
      publishedPosts.length === 0 ? (
        <div class="max-w-2xl mx-auto text-center py-16">
          <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg
              class="w-8 h-8 text-gray-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
              />
            </svg>
          </div>
          <p class="text-xl text-gray-600">まだ記事がありません</p>
          <p class="text-sm text-gray-500 mt-2">
            まもなく新しい記事を公開予定です。
          </p>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {publishedPosts.map((post) => (
            <article class="group relative bg-white border border-gray-200 rounded-xl overflow-hidden hover:shadow-xl hover:border-blue-300 transition-all duration-300">
              <div class="p-6">
                <header class="mb-4">
                  <h2 class="text-2xl font-bold text-gray-900 mb-3 group-hover:text-blue-600 transition-colors line-clamp-2">
                    <a
                      href={`/posts/${post.id}`}
                      class="before:absolute before:inset-0 focus:outline-none"
                      aria-label={`記事を読む: ${post.data.title}`}
                    >
                      {post.data.title}
                    </a>
                  </h2>

                  <div class="flex flex-wrap items-center gap-3 text-sm text-gray-500 mb-3">
                    <time
                      datetime={post.data.pubDate.toISOString()}
                      class="flex items-center gap-1"
                    >
                      <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                      >
                        <path
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          stroke-width="2"
                          d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                        />
                      </svg>
                      {post.data.pubDate.toLocaleDateString("ja-JP", {
                        year: "numeric",
                        month: "short",
                        day: "numeric",
                      })}
                    </time>
                    {post.data.author && (
                      <span class="flex items-center gap-1">
                        <svg
                          class="w-4 h-4"
                          fill="currentColor"
                          viewBox="0 0 20 20"
                        >
                          <path
                            fill-rule="evenodd"
                            d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z"
                            clip-rule="evenodd"
                          />
                        </svg>
                        {post.data.author}
                      </span>
                    )}
                  </div>

                  {post.data.description && (
                    <p class="text-gray-600 line-clamp-3 leading-relaxed mb-4">
                      {post.data.description}
                    </p>
                  )}

                  {post.data.tags && (
                    <div class="flex flex-wrap gap-2">
                      {post.data.tags.map((tag) => (
                        <span class="px-3 py-1 bg-blue-50 text-blue-800 rounded-full font-medium text-xs">
                          #{tag}
                        </span>
                      ))}
                    </div>
                  )}
                </header>

                <footer class="mt-4 pt-4 border-t border-gray-100">
                  <span class="text-blue-600 font-medium text-sm flex items-center gap-1 group-hover:gap-2 transition-all">
                    続きを読む
                    <svg
                      class="w-4 h-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M9 5l7 7-7 7"
                      />
                    </svg>
                  </span>
                </footer>
              </div>
            </article>
          ))}
        </div>
      )
    }

    <nav class="mt-16 pt-8 border-t border-gray-200 text-center">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-gray-600 hover:text-gray-900 font-medium transition-colors px-4 py-2 rounded-lg hover:bg-gray-100"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"
          ></path>
        </svg>
        ホームに戻る
      </a>
    </nav>
  </main>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  article:focus-within {
    outline: 2px solid var(--color-border-focus);
    outline-offset: 2px;
  }
</style>
